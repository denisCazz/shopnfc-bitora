{
  "name": "shopnfc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "db:setup": "bash scripts/setup-db.sh",
    "db:migrate": "node scripts/migrate-deploy.mjs",
    "db:seed": "npx tsx scripts/seed-catalog.ts",
    "db:clone-qa": "bash scripts/clone-db-to-qa-docker.sh",
    "db:recreate-qa": "FORCE_RECREATE=1 bash scripts/clone-db-to-qa-docker.sh",
    "dev": "next dev",
    "build": "node scripts/migrate-deploy.mjs --if-db && next build",
    "start": "node scripts/migrate-deploy.mjs --if-db && next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "analyze": "cross-env ANALYZE=true npm run build"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.0",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.38.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.577.0",
    "next": "16.1.7",
    "next-auth": "^5.0.0-beta.31",
    "pg": "^8.20.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.8.1",
    "resend": "^6.9.4",
    "sharp": "^0.34.5",
    "stripe": "^22.6.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.1.7",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.1.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
